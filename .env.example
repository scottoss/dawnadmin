# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NOTE FROM DEV: U DONT NEED THIS!!!!!!!!!!!
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stoat / DawnChat MongoDB Connection
# Set MONGODB_URI to connect directly to the main Stoat MongoDB instance.
# Example: mongodb://username:password@mongodb-host:27017/revolt?authSource=admin
MONGODB_URI="mongodb://localhost:27017/revolt"
MONGODB_DB="revolt"

# Announcement Sender Bot Configuration
# ANNOUNCEMENT_BOT_ID: The Bot User ID used to broadcast system announcements.
# ANNOUNCEMENT_BOT_TOKEN: Bot token used to dispatch messages via the Revolt/Stoat Bot API with live WebSocket events.
# STOAT_API_URL: Primary Stoat/Revolt HTTP API endpoint (default: https://api.dawn-chat.com).
ANNOUNCEMENT_BOT_ID="01HQBOT0000000000000000000"
ANNOUNCEMENT_BOT_TOKEN="your_bot_token_here"
STOAT_API_URL="https://api.dawn-chat.com"
